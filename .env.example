# Local development only. Copy to .env (docker compose) and .dev.vars (wrangler/vite).
# These values are not secrets — they are the documented local defaults.

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=casthop_dev_secret_not_for_production_use_32b
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880

# Compositor records to ./data/recordings inside the egress container.
EGRESS_OUTPUT_DIR=/out

# Default local RTMP stand-ins (MediaMTX). Replace with real YouTube / LinkedIn / X
# ingest URLs when you have them. Do not commit real stream keys.
RTMP_YOUTUBE=rtmp://127.0.0.1:1935/live/youtube
RTMP_LINKEDIN=rtmp://127.0.0.1:1935/live/linkedin
RTMP_X=rtmp://127.0.0.1:1935/live/x
EGRESS_TEMPLATE_URL=http://127.0.0.1:5173/egress-template

# Optional GitHub OAuth and mail webhook live in .dev.vars (Worker secrets).
