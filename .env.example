# Local media plane (docker compose) and a copy of Worker-facing URLs.
# Copy to .env (gitignored). These values are documented local defaults, not secrets.
# Worker-only vars (GitHub OAuth, mail, YouTube Live chat, PUBLIC_ORIGIN, CASTHOP_*) live in .dev.vars.

# LiveKit API key. Published local default; loopback-only.
LIVEKIT_API_KEY=devkey
# LiveKit API secret. Public local default; never use outside loopback.
LIVEKIT_API_SECRET=casthop_dev_secret_not_for_production_use_32b
# Where the Worker reaches LiveKit HTTP.
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
# LiveKit WebSocket URL browsers connect to.
PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880

# Path inside the egress container (compose mounts ./data/recordings here). Not a Worker var.
EGRESS_OUTPUT_DIR=/out
# Compositor page Egress opens.
EGRESS_TEMPLATE_URL=http://127.0.0.1:5173/egress-template

# Local RTMP stand-ins (MediaMTX). New studios copy these only when they are
# loopback; owners set real ingest URLs per studio.
RTMP_YOUTUBE=rtmp://127.0.0.1:1935/live/youtube
RTMP_LINKEDIN=rtmp://127.0.0.1:1935/live/linkedin
RTMP_X=rtmp://127.0.0.1:1935/live/x
