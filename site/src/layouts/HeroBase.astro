---
import "@fontsource-variable/geist-mono";
import "../styles/hero-variants.css";

interface Props { title: string; font: string; }
const { title, font } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Hero preview for the Casthop site." />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="hv" style={`--hv-sans: ${font}`}>
    <a class="hv-skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
