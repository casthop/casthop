# Worker secrets and vars for wrangler / bun run dev. Copy to .dev.vars (gitignored).
# These local values are documented defaults, not production secrets.

# LiveKit API key. Published local default; loopback-only.
LIVEKIT_API_KEY=devkey
# LiveKit API secret. Keep in Worker secrets. Never send to the browser.
LIVEKIT_API_SECRET=casthop_dev_secret_not_for_production_use_32b
# HMAC for Worker→Durable Object host keys. Falls back to LIVEKIT_API_SECRET if unset.
# HOST_KEY_SECRET=
# Allow the published devkey with a non-loopback LiveKit URL. Tests only.
# CASTHOP_ALLOW_DEV_KEYS=1
# Return the sign-in link in the magic-link response, for e2e, `bun run measure` and
# /internal/probe. Keep the dev server on 127.0.0.1. Otherwise use the link the Worker logs.
# CASTHOP_DEV_LOGIN=1
# Where the Worker reaches LiveKit HTTP.
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
# LiveKit WebSocket URL browsers connect to.
PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
# Default YouTube destination (local MediaMTX stand-in).
RTMP_YOUTUBE=rtmp://127.0.0.1:1935/live/youtube
# Default LinkedIn destination (local MediaMTX stand-in).
RTMP_LINKEDIN=rtmp://127.0.0.1:1935/live/linkedin
# Default X destination (local MediaMTX stand-in).
RTMP_X=rtmp://127.0.0.1:1935/live/x
# Compositor page Egress opens.
EGRESS_TEMPLATE_URL=http://127.0.0.1:5173/egress-template

# Optional GitHub OAuth. Leave unset to hide the GitHub button.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional YouTube Live chat ingest. Unset hides destination comments; the studio stays quiet (no errors).
# API key + live chat id (or video id), or a YouTube Data API OAuth refresh token (finds the active broadcast).
# YOUTUBE_API_KEY=
# YOUTUBE_LIVE_CHAT_ID=
# YOUTUBE_VIDEO_ID=
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REFRESH_TOKEN=

# Optional Twitch and Kick chat while live (read-only, no login). Unset hides them.
# Twitch channel name; Kick numeric chatroom id. X chat is not supported (no free chat API).
# TWITCH_CHANNEL=
# KICK_CHATROOM_ID=

# Optional mail webhook. Unset = log the magic link to the Worker console.
# POST JSON { to, subject, text }. No paid provider required.
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=

# Public site URL for magic-link mail, co-host invites, and GitHub OAuth.
# Unset locally (loopback Host is used). Set this in production so a spoofed Host cannot mint links to an attacker.
# PUBLIC_ORIGIN=https://casthop.example

# Trust CF-Connecting-IP / X-Forwarded-For only when a reverse proxy sets them.
# Cloudflare sets request.cf, so this is not needed there. Do not enable for wrangler dev.
# Behind a proxy, set this so per-IP sign-in limits apply to real clients; otherwise they share the local bucket.
# CASTHOP_TRUST_FORWARDED=1

# Optional timing overrides (milliseconds). Unset = code defaults. Used in tests.
# Empty-studio grace before ending live. Default 45000.
# CASTHOP_EMPTY_GRACE_MS=
# Wait for compositor Chrome to join after StartRoomComposite. Default 15000.
# CASTHOP_COMPOSITOR_GRACE_MS=
# Give up restarting a dead compositor. Default 30000.
# CASTHOP_RECOVERY_MS=
# Compositor heartbeat is stale after this. Default 3000 (page beats every 1s).
# CASTHOP_HEARTBEAT_MS=
# Override RTMP retry backoff. Unset = 1s, 2s, 4s, 8s, 16s, 30s. Set 0 in tests.
# CASTHOP_BACKOFF_MS=

# Hosted mode (optional). Every line is off unless set. See the Configuration docs.
# Comma list of kid:secret (secret 32+ chars). Enables GET /api/auth/external.
# CASTHOP_EXTERNAL_AUTH_KEYS=
# Required with the keys above: the token `iss` claim.
# CASTHOP_EXTERNAL_AUTH_ISSUER=
# Set to "external" to turn off magic-link and GitHub sign-in.
# CASTHOP_SIGNIN=
# Comma list of kid:secret (secret 32+ chars). Enables the signed /api/service/* API.
# CASTHOP_SERVICE_KEYS=
