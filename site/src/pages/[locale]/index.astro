---
import HeroBase from "../../layouts/HeroBase.astro";
import HeroPage from "../../components/home/HeroPage.astro";
import { otherLocales, type Locale } from "../../i18n";

export function getStaticPaths() {
  return otherLocales().map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
---
<HeroBase locale={locale} path="/">
  <HeroPage locale={locale} />
</HeroBase>
<script>
  import { mountBackground } from "../../components/heroes/runtime";
  import { grid } from "../../components/heroes/grid";
  import { enhanceScroll } from "../../components/home/scroll";
  const canvas = document.getElementById("hero-canvas");
  if (canvas instanceof HTMLCanvasElement) mountBackground(canvas, grid);
  enhanceScroll();
</script>
