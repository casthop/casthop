---
interface Props { label: string; id?: string; }
const { label, id = "nav-more" } = Astro.props;
---
<div class="nav-more" data-disclosure-root>
  <button
    type="button"
    class="nav-more-btn"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls={id}
    aria-label={label}
    data-disclosure
  >
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
      <path d="M3 4.5h12M3 9h12M3 13.5h12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>
  <div id={id} class="nav-more-panel" hidden data-disclosure-panel>
    <slot />
  </div>
</div>
<script>
  import { bindDisclosures } from "../lib/disclosure";
  bindDisclosures();
</script>
