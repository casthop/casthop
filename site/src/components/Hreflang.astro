---
import { LOCALES, SITE_URL, withLocale, type Locale } from "../i18n";

interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
---
{LOCALES.map((id) => (
  <link rel="alternate" hreflang={id} href={`${SITE_URL}${withLocale(id, path)}`} />
))}
<link rel="alternate" hreflang="x-default" href={`${SITE_URL}${withLocale("en", path)}`} />
<link rel="canonical" href={`${SITE_URL}${withLocale(locale, path)}`} />
