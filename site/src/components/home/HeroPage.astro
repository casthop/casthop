---
import ExtLink from "../ExtLink.astro";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import NavMore from "../NavMore.astro";
import { GITHUB } from "../../lib/site";
import { t, withLocale, type Locale } from "../../i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const home = withLocale(locale, "/");
const features = [
  { n: "01", title: t(locale, "feature1Title"), body: t(locale, "feature1Body"), href: withLocale(locale, "/docs/destinations/"), label: t(locale, "feature1Link") },
  { n: "02", title: t(locale, "feature2Title"), body: t(locale, "feature2Body"), href: withLocale(locale, "/docs/guests/"), label: t(locale, "feature2Link") },
  { n: "03", title: t(locale, "feature3Title"), body: t(locale, "feature3Body"), href: withLocale(locale, "/docs/architecture/"), label: t(locale, "feature3Link") },
  { n: "04", title: t(locale, "feature4Title"), body: t(locale, "feature4Body"), href: withLocale(locale, "/docs/destinations/"), label: t(locale, "feature4Link") },
];
---
<header class="hv-nav">
  <div class="hv-nav-in">
    <a href={home} class="hv-logo" aria-label={t(locale, "brandHome")}><span class="hv-dot" aria-hidden="true"></span>Casthop</a>
    <nav aria-label={t(locale, "navMain")} class="hv-nav-links">
      <a class="hv-nav-sec" href={withLocale(locale, "/docs/")}>{t(locale, "navDocs")}</a>
      <ExtLink class="hv-nav-sec" href={GITHUB}>{t(locale, "navGithub")}</ExtLink>
      <NavMore label={t(locale, "navMenu")} id="site-nav-more">
        <a href={withLocale(locale, "/docs/")}>{t(locale, "navDocs")}</a>
        <ExtLink href={GITHUB}>{t(locale, "navGithub")}</ExtLink>
      </NavMore>
      <LanguageSwitcher locale={locale} path="/" label={t(locale, "language")} />
      <a class="hv-btn hv-btn-quiet hv-nav-cta" href={withLocale(locale, "/docs/getting-started/")}>{t(locale, "navGetStarted")}</a>
    </nav>
  </div>
</header>

<main id="main">
  <section class="hv-hero">
    <canvas id="hero-canvas" class="hv-canvas" aria-hidden="true"></canvas>
    <div class="hv-scrim" aria-hidden="true"></div>
    <div class="hv-wrap hv-hero-copy">
      <p class="hv-eyebrow"><span class="hv-pip" aria-hidden="true"></span>{t(locale, "heroEyebrow")}</p>
      <h1 class="hv-display">{t(locale, "heroTitle")}</h1>
      <p class="hv-lede">{t(locale, "heroLede")}</p>
      <div class="hv-cta">
        <ExtLink href={GITHUB} class="hv-btn hv-btn-primary">{t(locale, "heroRepo")}</ExtLink>
        <a class="hv-link" href={withLocale(locale, "/docs/getting-started/")}>{t(locale, "heroDocs")} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hv-shot-wrap">
      <div class="hv-shot-stage">
        <figure class="hv-shot">
          <img src="/studio.png" width="1440" height="900" alt={t(locale, "heroAlt")} fetchpriority="high" />
        </figure>
      </div>
    </div>
  </section>

  <div class="hv-rest">
    <section class="hv-wrap hv-features" aria-labelledby="features-h">
      <h2 id="features-h" class="hv-section-title hv-reveal">{t(locale, "featuresTitle")}</h2>
      {features.map((s) => (
        <article class="hv-feature hv-reveal">
          <p class="hv-feature-n">{s.n}</p>
          <div>
            <h3 class="hv-feature-t">{s.title}</h3>
            <p class="hv-feature-b">{s.body}</p>
            <a class="hv-link" href={s.href}>{s.label} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </section>

    <section class="hv-wrap hv-oss hv-reveal" aria-labelledby="oss-h">
      <p class="hv-eyebrow">{t(locale, "ossEyebrow")}</p>
      <h2 id="oss-h" class="hv-display hv-display-sm">{t(locale, "ossTitle")}</h2>
      <div class="hv-oss-cols">
        <p>{t(locale, "ossP1")}</p>
        <p>{t(locale, "ossP2")}</p>
      </div>
      <div class="hv-cta">
        <ExtLink href={GITHUB} class="hv-btn hv-btn-outline">{t(locale, "ossGithub")}</ExtLink>
        <a class="hv-link" href={withLocale(locale, "/docs/self-hosting/")}>{t(locale, "ossDocs")} <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</main>

<footer class="hv-footer hv-reveal">
  <div class="hv-wrap hv-footer-in">
    <div>
      <a href={home} class="hv-logo" aria-label={t(locale, "brandHome")}><span class="hv-dot" aria-hidden="true"></span>Casthop</a>
      <p class="hv-muted hv-small">{t(locale, "footerTagline")}</p>
    </div>
    <nav aria-label={t(locale, "footerDocs")} class="hv-footer-col">
      <p class="hv-small hv-label">{t(locale, "footerDocs")}</p>
      <a href={withLocale(locale, "/docs/getting-started/")}>{t(locale, "footerGettingStarted")}</a>
      <a href={withLocale(locale, "/docs/self-hosting/")}>{t(locale, "footerSelfHosting")}</a>
      <a href={withLocale(locale, "/docs/configuration/")}>{t(locale, "footerConfiguration")}</a>
      <a href={withLocale(locale, "/docs/architecture/")}>{t(locale, "footerArchitecture")}</a>
    </nav>
    <nav aria-label={t(locale, "footerProject")} class="hv-footer-col">
      <p class="hv-small hv-label">{t(locale, "footerProject")}</p>
      <ExtLink href={GITHUB}>{t(locale, "navGithub")}</ExtLink>
      <ExtLink href={`${GITHUB}/blob/main/LICENSE`}>AGPL-3.0-only</ExtLink>
    </nav>
  </div>
  <p class="hv-wrap hv-muted hv-small hv-footer-lic">{t(locale, "footerLicense")}</p>
</footer>
