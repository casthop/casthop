---
import Base from "../../layouts/Base.astro";
import { t } from "../../i18n";
---
<Base
  title={t("en", "docsChromeTitle")}
  description={t("en", "docsChromeDescription")}
  theme="light"
  locale="en"
  path="/docs/"
  skip={t("en", "skip")}
>
  <meta http-equiv="refresh" content="0;url=/docs/getting-started/" slot="head" />
  <main id="main" style="padding:4rem 1.5rem;max-width:40rem;margin:auto">
    <p><a href="/docs/getting-started/">{t("en", "continueTo")}</a></p>
  </main>
</Base>
