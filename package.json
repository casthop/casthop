{
  "name": "casthop",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Open-source browser live studio — guests, layouts, multistream, recording.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "cargo fmt -p casthop-media -p casthop-post -- --check",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "node scripts/e2e-live.mjs",
    "check:wasm": "node scripts/check-wasm-budget.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "bench:wasm": "tsx scripts/bench-wasm.mjs",
    "measure": "bash scripts/measure.sh",
    "postinstall": "node scripts/copy-mediapipe.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.2.7",
    "@mediapipe/tasks-vision": "^0.10.21",
    "hono": "^4.9.9",
    "livekit-client": "^2.15.8",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.168.0",
    "ws": "^8.23.0"
  }
}
