{
  "name": "casthop",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Open-source browser live studio — guests, layouts, multistream, recording.",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "cargo fmt -p casthop-media -p casthop-post -- --check",
    "test": "bun test --max-concurrency=1",
    "test:e2e": "bun scripts/e2e-live.mjs",
    "test:e2e-ui": "E2E_TELEMETRY_DISABLED=1 bunx --bun e2e run --strict-cache",
    "check:wasm": "bun scripts/check-wasm-budget.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "bench:wasm": "bun scripts/bench-wasm.mjs",
    "measure": "bash scripts/measure.sh",
    "postinstall": "bun scripts/copy-mediapipe.mjs"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.2.7",
    "@mediapipe/tasks-vision": "^0.10.21",
    "hono": "^4.9.9",
    "livekit-client": "^2.15.8",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@e2e-dev/web": "^0.17.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "e2e": "^0.25.0",
    "playwright-core": "1.65.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.168.0",
    "ws": "^8.23.0"
  }
}
