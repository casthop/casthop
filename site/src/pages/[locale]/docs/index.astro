---
import Base from "../../../layouts/Base.astro";
import { otherLocales, t, withLocale, type Locale } from "../../../i18n";

export function getStaticPaths() {
  return otherLocales().map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const dest = withLocale(locale, "/docs/getting-started/");
---
<Base
  title={t(locale, "docsChromeTitle")}
  description={t(locale, "docsChromeDescription")}
  theme="light"
  locale={locale}
  path="/docs/"
  skip={t(locale, "skip")}
>
  <meta http-equiv="refresh" content={`0;url=${dest}`} slot="head" />
  <main id="main" style="padding:4rem 1.5rem;max-width:40rem;margin:auto">
    <p><a href={dest}>{t(locale, "continueTo")}</a></p>
  </main>
</Base>
